# AI TrustGuard Configuration Template
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL or standard PostgreSQL)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Authentication
JWT_SECRET=ai_trustguard_super_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API (Backend only - never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
